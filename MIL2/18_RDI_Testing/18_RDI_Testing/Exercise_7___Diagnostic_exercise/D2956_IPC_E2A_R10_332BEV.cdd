<ENUMDEF id='_00000251ADFCAF50' oid='7CE50BBB07A044578AC843EFA5136C21' attrcatref='_00000251CEA3E790' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>PacketHandlerOption</TUV>
<TUV xml:lang='it'>PacketHandlerOption</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Provide type of current Packet Handler for first found Service Positive Response.
Restriction: Only evaluated if Folder attribute 'PacketHandlerSupport' is set to 'all'.</TUV>
<TUV xml:lang='it'>Provide type of current Packet Handler for first found Service Positive Response.
Restriction: Only evaluated if Folder attribute 'PacketHandlerSupport' is set to 'all'.</TUV>
</DESC>
