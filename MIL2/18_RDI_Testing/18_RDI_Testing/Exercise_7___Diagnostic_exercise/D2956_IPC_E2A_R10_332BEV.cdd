<SPECDATAOBJ oid='514FEE30897F4568802DC611BED48937'>
<NAME>
<TUV xml:lang='en-US'>NEGATIVE RESPONSE CODES</TUV>
<TUV xml:lang='it'>CODICI DI RISPOSTA NEGATIVI</TUV>
</NAME>
<QUAL>NRC</QUAL>
<NEGRESCODEPROXIES>
<NEGRESCODEPROXY idref='_00000251B08C5160'/>
<NEGRESCODEPROXY idref='_00000251B08C5010'/>
<NEGRESCODEPROXY idref='_00000251B08C4EC0'/>
<NEGRESCODEPROXY idref='_00000251B08C5940'/>
<NEGRESCODEPROXY idref='_00000251B08C4830'/>
