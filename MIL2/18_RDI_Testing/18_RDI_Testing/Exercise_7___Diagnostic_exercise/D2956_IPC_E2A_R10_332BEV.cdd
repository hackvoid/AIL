<DESC>
<TUV xml:lang='en-US' struct='1'><PARA><FC>All the Variant must be </FC>
<FC b='1'>referenced </FC>
<FC>and </FC>
<FC b='1'>not copied</FC>
<FC>.</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC b='1'>FCA diagnosis reference standards:</FC>
</PARA>
<PARA list='bul'><FC>CS.00051 - FCA ITALY STANDARD UNIFIED DIAGNOSTIC SERVICES (UDS) ON CAN (LOW / HIGH SPEED)</FC>
</PARA>
<PARA list='bul'><FC>CS.00052 - GENERAL DIAGNOSTIC SPECIFICATION COMPLYING WITH COMMUNICATION PROTOCOL STANDARD CS.00051</FC>
</PARA>
<PARA list='bul'><FC>CS.00053 - GENERAL PROGRAMMING REQUIREMENTS FOR FLASH EEPROM, EXTENSION FOR ECUs COMPLIANT TO COMMUNICATION PROTOCOL STANDARD CS.00051</FC>
</PARA>
<PARA list='bul'><FC>CS.00021 - DIAGNOSTIC REQUIREMENTS ADDENDUM FOR ATLANTIS - TIER 2</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
</TUV>
