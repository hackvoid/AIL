<DIAGINST id='_00000251D47688C0' oid='60FF5F26E00B4e6aAA619A9C009E9290' tmplref='_00000251D421BFF0' req='notReq'>
<NAME>
<TUV xml:lang='en-US'>Info Reset Odometer</TUV>
<TUV xml:lang='it' uptodate='0'></TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US' struct='1'><PARA><FC fs='220'>·	</FC>
<FC b='1' fs='220'>0x00 RESET NOT NECESSARY</FC>
<FC fs='220'> [Value that the RDI has to assume and maintain when the market is equal to NAFTA in agreement to the proxi (H letter not present for NAFTA version) ]</FC>
</PARA>
<PARA><FC fs='220'>The following values are used only when the market is different from NAFTA:</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC fs='220'>·	</FC>
<FC b='1' fs='220'>0x01 RESET NOT OK</FC>
<FC fs='220'> [the RDI must be set to this value while the H letter visualization is NOT disabled: see below </FC>
<FC b='1' fs='220'>Reset OK</FC>
<FC fs='220'> value description for all the complementary conditions when the reset of the H letter is performed]</FC>
</PARA>
<PARA><FC fs='220'>·	</FC>
<FC b='1' fs='220'>0x02 RESET OK</FC>
<FC fs='220'> [the RDI will assume this value when the H letter visualization is disabled and this happens when:</FC>
</PARA>
<PARA><FC fs='220'>a)	the distance traveled is more than 200km (even without odometer reset)</FC>
</PARA>
<PARA><FC fs='220'>b)	diagnostic IOLI command while the distance traveled is less than 200km</FC>
</PARA>
<PARA><FC fs='220'>c)	manual odometer reset by pressing the dedicated button while the distance traveled is less than 200km ]</FC>
</PARA>
</TUV>
<TUV xml:lang='it' uptodate='0' struct='1'></TUV>
</DESC>
<QUAL>Info_Reset_Odometer</QUAL>
<SERVICE id='_00000251D470B6A0' oid='480F33280A254498A8F84A84423791BB' tmplref='_00000251D4597660' func='1' phys='1' respOnPhys='1' respOnFunc='1' req='0' mayBeExec='(1,3)'>
