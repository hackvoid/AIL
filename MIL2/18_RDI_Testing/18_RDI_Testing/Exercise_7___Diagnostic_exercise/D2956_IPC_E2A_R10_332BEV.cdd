<DIAGINST id='_00000251D4B60E60' oid='310BDB2F2BC54df0BF2DD5CDB2F79EB1' tmplref='_00000251D45A39E0' req='notReq'>
<NAME>
<TUV xml:lang='en-US'>Autocheck</TUV>
<TUV xml:lang='it'>Autocheck</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US' struct='1'><PARA><FC fs='200'>Con questo comando NQS si comporta in questo modo:</FC>
</PARA>
<PARA list='bul'><FC fs='200'>Tutti gli indicatori sono pilotati da 0 a fondo scala entro 4sec e da fondo scala a 0 entro 4sec.</FC>
</PARA>
<PARA list='bul'><FC fs='200'>Tutti i leds presenti sono accesi anche se non configurati</FC>
</PARA>
<PARA list='bul'><FC fs='200'>Tutti i segmenti e i pixels del display sono visibili</FC>
</PARA>
<PARA list='bul'><FC fs='200'>Il buzzer è attivo</FC>
</PARA>
<PARA list='bul'><FC fs='200'>Le illuminazioni delle scale grafiche,display, pointer sono accese.</FC>
</PARA>
</TUV>
<TUV xml:lang='it' struct='1'><PARA><FC fs='200'>Con questo comando NQS si comporta in questo modo:</FC>
</PARA>
<PARA list='bul'><FC fs='200'>Tutti gli indicatori sono pilotati da 0 a fondo scala entro 4sec e da fondo scala a 0 entro 4sec.</FC>
</PARA>
<PARA list='bul'><FC fs='200'>Tutti i leds presenti sono accesi anche se non configurati</FC>
</PARA>
<PARA list='bul'><FC fs='200'>Tutti i segmenti e i pixels del display sono visibili</FC>
</PARA>
<PARA list='bul'><FC fs='200'>Il buzzer è attivo</FC>
</PARA>
<PARA list='bul'><FC fs='200'>Le illuminazioni delle scale grafiche,display, pointer sono accese.</FC>
</PARA>
</TUV>
</DESC>
<QUAL>Autocheck</QUAL>
