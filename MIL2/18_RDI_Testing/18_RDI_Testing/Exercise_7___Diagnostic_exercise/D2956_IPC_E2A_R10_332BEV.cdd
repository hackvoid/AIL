<DIAGINST id='_00000251D4769EC0' oid='7B464479EAA54934AFC89F04070F6228' tmplref='_00000251D421BFF0' req='req'>
<NAME>
<TUV xml:lang='en-US'>KeyOn counter (EEPROM)</TUV>
<TUV xml:lang='it'>Contatore di KeyOn (EEPROM)</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US' struct='1'><PARA><FC tcol='0'>RDI $200A management reported in 09009 is changed as reported following. </FC>
</PARA>
<PARA><FC tcol='0'>The Ignition ON Counter shall be bussed from BCM periodically each 1 s (and not, as reported in 09009, 10 times at each Ignition On 1 seconds after Ignition On). The ECU, after the Ignition On counter correctly receiving, will store the value in RDI $200A. </FC>
</PARA>
<PARA><FC></FC>
</PARA>
</TUV>
<TUV xml:lang='it' struct='1'><PARA><FC tcol='0'>RDI $200A management reported in 09009 is changed as reported following. </FC>
</PARA>
<PARA><FC tcol='0'>The Ignition ON Counter shall be bussed from BCM periodically each 1 s (and not, as reported in 09009, 10 times at each Ignition On 1 seconds after Ignition On). The ECU, after the Ignition On counter correctly receiving, will store the value in RDI $200A. </FC>
</PARA>
<PARA><FC></FC>
</PARA>
</TUV>
</DESC>
<QUAL>KeyOn_counter_EEPROM</QUAL>
<SERVICE id='_00000251D470BB20' oid='9A447E53168A4ffd9B6A1ECB93352C7B' tmplref='_00000251D4597660' func='1' phys='1' respOnPhys='1' respOnFunc='1' req='0' mayBeExec='(1,3,5)'>
