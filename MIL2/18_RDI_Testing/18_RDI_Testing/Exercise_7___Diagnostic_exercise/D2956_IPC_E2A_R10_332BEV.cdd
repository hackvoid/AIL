<DIAGINST id='_00000251D48A3690' oid='ED70D178379649e0B6508A0089E79AD5' tmplref='_00000251D421C900' req='notReq'>
<NAME>
<TUV xml:lang='en-US'>EcuSerialNumber</TUV>
<TUV xml:lang='it'>EcuSerialNumber</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US' struct='1'><PARA><FC>This value shall be used to reference the ECU serial number. This field must be filled at the system supplier end of line and must unambiguosly identify each ECU.</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><IMAGEPROXY sizeh='18888' sizev='13968' idref='_00000251CE7B73D0'/>
</PARA>
<PARA><FC>This record shall be used to uniquely identify specific ECU hardware to be able to identify ECUs of a specific batch assigned by system supplier. It must be programmed at system supplier end of line and must not change after a flash programming.</FC>
</PARA>
<PARA><FC>This number is also referred to as a Traceability Number.</FC>
</PARA>
<PARA><FC>An ECU shall report the identical information regardless of the current mode of the ECU (application software or bootloader) in all available sessions and in Physical and Functional mode.</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC i='1'>Note </FC>
<FC b='1'>:</FC>
<FC> Supplier Option and Component Code on FGA applications shall be populated according to TFO 07610.</FC>
</PARA>
<PARA><FC>i.e. : Magneti Marelli SpA - Electronic Systems : C141 (ASCII) will be coded as following :</FC>
</PARA>
<PARA list='bul'><FC>Supplier Option :</FC>
</PARA>
<PARA><FC>              1 = 0x43 (C)</FC>
</PARA>
<PARA><FC>              2 = 0x31 (1)</FC>
</PARA>
<PARA list='bul'><FC>Component Code:</FC>
</PARA>
<PARA><FC>              3 = 0x34 (4)</FC>
</PARA>
<PARA><FC>              4 = 0x31 (1)</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC b='1' fs='180'>Example of $F18C:</FC>
</PARA>
<PARA><FC fs='180'>0 0200A 3 044 85C4 T</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC fs='180'>0 = request value for byte 14</FC>
</PARA>
<PARA><FC fs='180'>0200 = bytes 10,11,12,13: plant’s daily production</FC>
</PARA>
<PARA><FC fs='180'>A = byte 9: single character code, identifying assembly line, shift, plant, etc., as determined by the supplier</FC>
</PARA>
<PARA><FC fs='180'>3 = byte 8: calendar year</FC>
</PARA>
<PARA><FC fs='180'>044 = bytes 5,6,7: day of year</FC>
</PARA>
<PARA><FC fs='180'>85 = bytes 3,4: Component code</FC>
</PARA>
<PARA><FC fs='180'>C4 = bytes 1,2: Supplier Option</FC>
</PARA>
<PARA><FC fs='180'>T = byte 0 (Traceability Data)</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
</TUV>
<TUV xml:lang='it' struct='1'><PARA><FC>This value shall be used to reference the ECU serial number. This field must be filled at the system supplier end of line and must unambiguosly identify each ECU.</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><IMAGEPROXY sizeh='18888' sizev='13968' idref='_00000251CE7B73D0'/>
</PARA>
<PARA><FC>This record shall be used to uniquely identify specific ECU hardware to be able to identify ECUs of a specific batch assigned by system supplier. It must be programmed at system supplier end of line and must not change after a flash programming.</FC>
</PARA>
<PARA><FC>This number is also referred to as a Traceability Number.</FC>
</PARA>
<PARA><FC>An ECU shall report the identical information regardless of the current mode of the ECU (application software or bootloader) in all available sessions and in Physical and Functional mode.</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC i='1'>Note </FC>
<FC b='1'>:</FC>
<FC> Supplier Option and Component Code on FGA applications shall be populated according to TFO 07610.</FC>
</PARA>
<PARA><FC>i.e. : Magneti Marelli SpA - Electronic Systems : C141 (ASCII) will be coded as following :</FC>
</PARA>
<PARA list='bul'><FC>Supplier Option :</FC>
</PARA>
<PARA><FC>              1 = 0x43 (C)</FC>
</PARA>
<PARA><FC>              2 = 0x31 (1)</FC>
</PARA>
<PARA list='bul'><FC>Component Code:</FC>
</PARA>
<PARA><FC>              3 = 0x34 (4)</FC>
</PARA>
<PARA><FC>              4 = 0x31 (1)</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC b='1' fs='180'>Example of $F18C:</FC>
</PARA>
<PARA><FC fs='180'>0 0200A 3 044 85C4 T</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC fs='180'>0 = request value for byte 14</FC>
</PARA>
<PARA><FC fs='180'>0200 = bytes 10,11,12,13: plant’s daily production</FC>
</PARA>
<PARA><FC fs='180'>A = byte 9: single character code, identifying assembly line, shift, plant, etc., as determined by the supplier</FC>
</PARA>
<PARA><FC fs='180'>3 = byte 8: calendar year</FC>
</PARA>
<PARA><FC fs='180'>044 = bytes 5,6,7: day of year</FC>
</PARA>
<PARA><FC fs='180'>85 = bytes 3,4: Component code</FC>
</PARA>
<PARA><FC fs='180'>C4 = bytes 1,2: Supplier Option</FC>
</PARA>
<PARA><FC fs='180'>T = byte 0 (Traceability Data)</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
</TUV>
</DESC>
<QUAL>EcuSerialNumber</QUAL>
<SERVICE id='_00000251D4971B00' oid='95CA1BFDE593425a9FC84363A295F16F' tmplref='_00000251D4598010' func='1' phys='1' respOnPhys='1' respOnFunc='1' req='0'>
