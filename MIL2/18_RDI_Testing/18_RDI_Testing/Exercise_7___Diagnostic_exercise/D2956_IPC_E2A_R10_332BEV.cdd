<DATAOBJ oid='10F5F6434D2F4357BD67E67981AF4E36' spec='no' dtref='_00000251D41ECF50'>
<NAME>
<TUV xml:lang='en-US'>Signature failure event in last ECU reprogramming attempt</TUV>
<TUV xml:lang='it'>Signature failure event in last ECU reprogramming attempt</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Bit 1 is set to 0x01 if, during last reprogrammign attempt, calculated signature is different from the expected value; it is set to 0x00 when calculated signature is equal to the expected value.</TUV>
<TUV xml:lang='it'>Bit 1 is set to 0x01 if, during last reprogrammign attempt, calculated signature is different from the expected value; it is set to 0x00 when calculated signature is equal to the expected value.</TUV>
</DESC>
