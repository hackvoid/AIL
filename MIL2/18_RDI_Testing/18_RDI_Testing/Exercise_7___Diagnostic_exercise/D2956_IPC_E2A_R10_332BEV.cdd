<DIAGCLASS id='_00000251D46E4C00' oid='4AB45E42ED6A4678BC21B0841341F351' tmplref='_00000251D421BFF0'>
<NAME>
<TUV xml:lang='en-US'>Engineering Parameters</TUV>
<TUV xml:lang='it'>Parametri Ingegneristici</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US' struct='1'><PARA><ATTACHPROXY idref='_00000251CE7B6FB0'/>
<FC>Shall be guaranteed that the ECU can manages multiple RDI according to his buffer sizing, agreed with FIAT AUTO. </FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC b='1'>!!!!!!!!!!Example!!!!!!!!!!</FC>
</PARA>
<PARA><FC>Buffer size agreed 255 bytes. RDI $1234 (45 byte); RDI $5678 (123 byte); RDI $9ABC (433 byte) </FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC b='1'>Test Case A)</FC>
</PARA>
<PARA><FC>Tester request $22 $1234 $5678 </FC>
</PARA>
<PARA><FC>ECU answer $62 $1234 $xx  $xx $xx $xx .. $5678 $yy $yy$yy ...</FC>
</PARA>
<PARA><FC b='1'>Test Case B)</FC>
</PARA>
<PARA><FC>Tester reuests $22 $1234 $5678 $ 9ABC</FC>
</PARA>
<PARA><FC>ECU answers $7F $22 $31</FC>
</PARA>
</TUV>
<TUV xml:lang='it' uptodate='0' struct='1'><PARA><FC>Shall be guaranteed that the ECU can manages multiple RDI according to his buffer sizing, agreed with FIAT AUTO. </FC>
</PARA>
<PARA><ATTACHPROXY idref='_00000251CE7B7480'/>
</PARA>
<PARA><FC b='1'>!!!!!!!!!!Example!!!!!!!!!!</FC>
</PARA>
<PARA><FC>Buffer size agreed 255 bytes. RDI $1234 (45 byte); RDI $5678 (123 byte); RDI $9ABC (433 byte) </FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC b='1'>Test Case A)</FC>
</PARA>
<PARA><FC>Tester request $22 $1234 $5678 </FC>
</PARA>
<PARA><FC>ECU answer $62 $1234 $xx  $xx $xx $xx .. $5678 $yy $yy$yy ...</FC>
</PARA>
<PARA><FC b='1'>Test Case B)</FC>
</PARA>
<PARA><FC>Tester reuests $22 $1234 $5678 $ 9ABC</FC>
</PARA>
<PARA><FC>ECU answers $7F $22 $31</FC>
</PARA>
</TUV>
</DESC>
<QUAL>EngineeringParameters</QUAL>
<DIAGINST id='_00000251D468FC70' oid='E43370206FBF487699DE33B138615E2A' tmplref='_00000251D421BFF0' req='notReq'>
