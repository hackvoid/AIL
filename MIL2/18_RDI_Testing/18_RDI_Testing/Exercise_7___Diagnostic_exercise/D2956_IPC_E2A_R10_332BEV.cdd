<TUV xml:lang='it' uptodate='0'></TUV>
</SHORTCUTNAME>
<SHORTCUTQUAL>Vehicle_Manufacturer_ECU_Software_Application_Number_Read</SHORTCUTQUAL>
</SERVICE>
