</DESC>
<QUAL>Secure_boot_and_signature_failure_information</QUAL>
<DATAOBJ oid='CE29F3965A4546b693159CF4D60B23B2' spec='no' dtref='_00000251D41ECF50'>
<NAME>
<TUV xml:lang='en-US'>Secure boot failure event in last ECU initialization</TUV>
<TUV xml:lang='it'>Secure boot failure event in last ECU initialization</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Bit 0 is set to 0x01 in case of secure boot is failed during last ECU initialization; it is set to 0x00 when there is a successful secure boot event</TUV>
<TUV xml:lang='it'>Bit 0 is set to 0x01 in case of secure boot is failed during last ECU initialization; it is set to 0x00 when there is a successful secure boot event</TUV>
