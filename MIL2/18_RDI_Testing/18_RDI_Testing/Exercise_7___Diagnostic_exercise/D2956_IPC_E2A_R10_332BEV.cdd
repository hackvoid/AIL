<DIAGINST id='_00000251D4B61860' oid='475F794870FA41ee8C0AB78BDFAEA442' tmplref='_00000251D45A3BB0' req='notReq'>
<NAME>
<TUV xml:lang='en-US'>Original VIN Unlock</TUV>
<TUV xml:lang='it'>Original VIN Unlock</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US' struct='1'><PARA><FC>If original VIN (0xF190) has been locked (by diagnostic command or in automatic way after 5 km or alternately after 10 key off / key on if CLUSTER1.TotalOdometer is not available</FC>
<FC tcol='255' fs='220'> </FC>
<FC>- see VF_607 for more details), this routine allows to unlock the original VIN (0xF190). This routine can be perfomed </FC>
<FC u='1'>only in Plant</FC>
<FC> in diagnostic session $40 (VehicleManufacturerEndOfLine) and by security access algorithm (security access sub-function $05 and $06).</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC>In order to unlock the original VIN, following steps must be done:</FC>
</PARA>
<PARA><FC>1. go in diagnostic session $40 (VehicleManufacturerEndOfLine) -&#62; $10 40</FC>
</PARA>
<PARA><FC>2. VINUnlockRequestSeed -&#62; $27 05</FC>
</PARA>
<PARA><FC>3. VINUnlockSendKey -&#62; $27 06 + 4 bytes</FC>
</PARA>
<PARA><FC>4. original VIN unlock -&#62; $31 01 2001</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC>This routine must be available </FC>
<FC u='1'>only</FC>
<FC> in diagnostic session $40 (VehicleManufacturerEndOfLine). If requested in other sessions, ECU must answer nack.</FC>
</PARA>
</TUV>
<TUV xml:lang='it' struct='1'><PARA><FC>If original VIN (0xF190) has been locked (by diagnostic command or in automatic way after 5 km or alternately after 10 key off / key on if CLUSTER1.TotalOdometer is not available</FC>
<FC tcol='255' fs='220'> </FC>
<FC>- see VF_607 for more details), this routine allows to unlock the original VIN (0xF190). This routine can be perfomed </FC>
<FC u='1'>only in Plant</FC>
<FC> in diagnostic session $40 (VehicleManufacturerEndOfLine) and by security access algorithm (security access sub-function $05 and $06).</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC>In order to unlock the original VIN, following steps must be done:</FC>
</PARA>
<PARA><FC>1. go in diagnostic session $40 (VehicleManufacturerEndOfLine) -&#62; $10 40</FC>
</PARA>
<PARA><FC>2. VINUnlockRequestSeed -&#62; $27 05</FC>
</PARA>
<PARA><FC>3. VINUnlockSendKey -&#62; $27 06 + 4 bytes</FC>
</PARA>
<PARA><FC>4. original VIN unlock -&#62; $31 01 2001</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC>This routine must be available </FC>
<FC u='1'>only</FC>
<FC> in diagnostic session $40 (VehicleManufacturerEndOfLine). If requested in other sessions, ECU must answer nack.</FC>
</PARA>
</TUV>
</DESC>
<QUAL>Original_VIN_Unlock</QUAL>
<SERVICE id='_00000251D4BC2B30' oid='4CC6A50926454525ABAF1A5453995666' tmplref='_00000251D45CBC00' func='0' phys='1' respOnPhys='1' respOnFunc='0' xaud='24' req='0' mayBeExec='(5,7,9,12,13,14,15)'>
