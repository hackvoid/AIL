<DIAGINST id='_00000251D4768EC0' oid='B9366E1E5A4A4e20B839B842C8058A6F' tmplref='_00000251D421BFF0' req='notReq'>
<NAME>
<TUV xml:lang='en-US'>Coupon number</TUV>
<TUV xml:lang='it'>Coupon number</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US' struct='1'><PARA><FC>Parametro PROXI.</FC>
</PARA>
<PARA><FC>Inofrmation report related to service internventions in After Sales.</FC>
</PARA>
<PARA><FC>Value is decremented each time a reset is performed during programmed service</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC>To a ReadDataByIdentifier request the ECU replies with information related to last service.</FC>
</PARA>
<PARA><FC>With a WriteDataByIdentifier request the Diagnostic tool sends the information related to the actual or (just completed) service intervention in After Sale for the entire vehicle (not just IPC).</FC>
</PARA>
<PARA><FC i='1'>Units of measurement conversion note: 1mile = (1/1,609) kilometer</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
</TUV>
<TUV xml:lang='it' struct='1'><PARA><FC>Parametro PROXI.</FC>
</PARA>
<PARA><FC>Inofrmation report related to service internventions in After Sales.</FC>
</PARA>
<PARA><FC>Value is decremented each time a reset is performed during programmed service</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC>To a ReadDataByIdentifier request the ECU replies with information related to last service.</FC>
</PARA>
<PARA><FC>With a WriteDataByIdentifier request the Diagnostic tool sends the information related to the actual or (just completed) service intervention in After Sale for the entire vehicle (not just IPC).</FC>
</PARA>
<PARA><FC i='1'>Units of measurement conversion note: 1mile = (1/1,609) kilometer</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
</TUV>
</DESC>
<QUAL>Coupon_number</QUAL>
