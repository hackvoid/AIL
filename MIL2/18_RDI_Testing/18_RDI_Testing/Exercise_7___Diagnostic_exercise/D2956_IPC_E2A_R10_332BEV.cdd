<DIAGINST id='_00000251D4769AC0' oid='0E7E3D8C4FA143de90C23EEAB932D8D8' tmplref='_00000251D421BFF0' req='notReq'>
<NAME>
<TUV xml:lang='en-US'>VIN LOCK State</TUV>
<TUV xml:lang='it'>VIN LOCK State</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US' struct='1'><PARA><FC>This data identifier is used to report the state of VIN LOCK.</FC>
</PARA>
<PARA><FC>It can be locked by:</FC>
</PARA>
<PARA><FC>- diagnostic tool command (routine $2000)</FC>
</PARA>
<PARA><FC>- if mileage exceeds the limit value MILEAGE_LOCK (5km) as reported in VF_607</FC>
</PARA>
<PARA><FC>- after 10 key off / key on if CLUSTER1.TotalOdometer is not available (see VF_607 for more details).</FC>
</PARA>
</TUV>
<TUV xml:lang='it' struct='1'><PARA><FC>This data identifier is used to report the state of VIN LOCK.
It can be locked by:
- diagnostic tool command (routine $2000)
- if mileage exceeds the limit value MILEAGE_LOCK (5km) as reported in VF_607
- after 10 key off / key on if CLUSTER1.TotalOdometer is not available (see VF_607 for more details).</FC>
</PARA>
</TUV>
</DESC>
<QUAL>VIN_LOCK_State</QUAL>
<SERVICE id='_00000251D47C6FC0' oid='6FB4DE29A56F4d41A8BA7D017FC36628' tmplref='_00000251D4597660' func='1' phys='1' respOnPhys='1' respOnFunc='1' req='0' mayBeExec='(1,3,5)'>
