<DIAGINST id='_00000251D48A5890' oid='D285676F710144f6B591C3DAAAA06012' tmplref='_00000251D421BFF0' req='notReq'>
<NAME>
<TUV xml:lang='en-US'>Secure Boot and Signature Failure Information</TUV>
<TUV xml:lang='it'>Secure Boot and Signature Failure Information</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US' struct='1'><PARA><FC tcol='0'>For more details refer to CS.00093 (par. 5.2.7). CS.00093 asks to set a DTC in case of secure boot authentication failure, but DID implementation is acceptable.</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC>Bit 0 is set to 0x01 in case of secure boot is failed during last ECU initialization; it is set to 0x00 when there is a successful secure boot event</FC>
</PARA>
<PARA><FC>Bit 1 is set to 0x01 if, during last reprogrammign attempt, calculated signature is different from the expected value; it is set to 0x00 when calculated signature is equal to the expected value.</FC>
</PARA>
<PARA><FC>NOTE: default values of all bits (new ECU) is 0x00. -&#62; DID must be available in all Diagnostic Sessions and in boot. In case of battery disconnection, it must not lose the previous value.</FC>
</PARA>
</TUV>
<TUV xml:lang='it' struct='1'><PARA><FC tcol='0'>For more details refer to CS.00093 (par. 5.2.7). CS.00093 asks to set a DTC in case of secure boot authentication failure, but DID implementation is acceptable.</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC>Bit 0 is set to 0x01 in case of secure boot is failed during last ECU initialization; it is set to 0x00 when there is a successful secure boot event</FC>
</PARA>
<PARA><FC>Bit 1 is set to 0x01 if, during last reprogrammign attempt, calculated signature is different from the expected value; it is set to 0x00 when calculated signature is equal to the expected value.</FC>
</PARA>
<PARA><FC>NOTE: default values of all bits (new ECU) is 0x00. -&#62; DID must be available in all Diagnostic Sessions and in boot. In case of battery disconnection, it must not lose the previous value.</FC>
</PARA>
</TUV>
</DESC>
<QUAL>Secure_Boot_and_Signature_Failure_Information</QUAL>
<SERVICE id='_00000251D48A0480' oid='ADC2B14A94504a238CC0868C87E30DFC' tmplref='_00000251D4597660' func='0' phys='1' respOnPhys='1' respOnFunc='0' req='0'>
<NAME>
<TUV xml:lang='en-US'>Read</TUV>
<TUV xml:lang='it'>Read</TUV>
</NAME>
<QUAL>Read</QUAL>
<SHORTCUTNAME>
<TUV xml:lang='en-US'>Secure Boot and Signature Failure Information Read</TUV>
<TUV xml:lang='it'>Secure Boot and Signature Failure Information Read</TUV>
</SHORTCUTNAME>
<SHORTCUTQUAL>Secure_Boot_and_Signature_Failure_Information_Read</SHORTCUTQUAL>
</SERVICE>
