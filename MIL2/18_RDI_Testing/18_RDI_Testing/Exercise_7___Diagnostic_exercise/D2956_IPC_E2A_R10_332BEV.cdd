<DIAGINST id='_00000251D47690C0' oid='A019D7F1066E4e55B695A2FBFEFDFC14' tmplref='_00000251D421BFF0' req='notReq'>
<NAME>
<TUV xml:lang='en-US'>Date last performed service</TUV>
<TUV xml:lang='it'>Date last performed service</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US' struct='1'><PARA><FC>This parameter is used for having information related to last programmed intrevention of Service in After Sale. After a reset service operation (IO-Control, IOLI 0x5569) this parameter is updated with the new date</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC>ReadDataByIdentifier request:</FC>
</PARA>
<PARA><FC>The ECU replies with information related to last service number (date of last performed service)</FC>
</PARA>
<PARA><FC>WriteDataByIdentifier:</FC>
</PARA>
<PARA><FC>used in case of IPC substitution for the realignement of the new component to the history of the vehicle</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
</TUV>
<TUV xml:lang='it' uptodate='0' struct='1'><PARA><FC>This parameter is used for having information related to last programmed intrevention of Service in After Sale. After a reset service operation (IO-Control, IOLI 0x5569) this parametere is updated with the new date

ReadDataByIdentifier request:
The ECU replies with information related to last service number (date of last performed service)

WriteDataByIdentifier:
used in case of IPC substitution for the realignement of the new component to the history of the vehicle


</FC>
</PARA>
</TUV>
</DESC>
<QUAL>Date_last_performed_service</QUAL>
<SERVICE id='_00000251D47C4740' oid='6B61B5DFC1584c24A10371825E4C65D5' tmplref='_00000251D4597660' func='0' phys='1' respOnPhys='1' respOnFunc='0' req='0' mayBeExec='(1,3,5)'>
